{
  "realm": "service-requests",
  "displayName": "Service Requests",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clientScopes": [
    {
      "name": "service-requests.read",
      "description": "Browse service requests",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "service-requests.write",
      "description": "Create requests and change their status",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "service-request-portal",
      "name": "Service Request Portal",
      "description": "Single-page application that consumes the Service Request API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:4173/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:4173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:4173/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "service-requests.read",
        "service-requests.write"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "agent",
      "email": "agent@example.com",
      "firstName": "Ana",
      "lastName": "Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "agent",
          "temporary": false
        }
      ]
    }
  ]
}
