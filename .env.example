# Base URL of the Service Request API.
# The provided OpenAPI document has no `servers` block; error examples use the
# `/api` prefix, so that is the assumed default.
VITE_API_BASE_URL=/api

# Serve the OpenAPI contract with Mock Service Worker instead of a real backend.
VITE_ENABLE_API_MOCKS=true

# OIDC provider. Defaults match the Keycloak realm in docker/keycloak.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/service-requests
VITE_OIDC_CLIENT_ID=service-request-portal
VITE_OIDC_SCOPE=openid profile email service-requests.read service-requests.write
